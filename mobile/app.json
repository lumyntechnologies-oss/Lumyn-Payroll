{
  "expo": {
    "name": "Lumyn Payroll",
    "slug": "lumyn-payroll-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "lumyn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.lumyn.payroll"
    },
    "android": {
      "package": "co.ke.lumyn.payroll"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
