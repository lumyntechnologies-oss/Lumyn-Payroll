generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clerkId   String   @unique
  name      String

  @@map("users")
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@map("departments")
}

model Employee {
  id             String          @id @default(cuid())
  employeeId     String          @unique
  firstName      String
  lastName       String
  email          String          @unique
  phone          String?
  nationalId     String?         @unique
  kraPin         String?         @unique
  nssfNumber     String?
  nhifNumber     String?
  dateOfBirth    DateTime?
  gender         Gender?
  departmentId   String
  jobTitle       String
  employmentType EmploymentType  @default(FULL_TIME)
  hireDate       DateTime
  terminatedAt   DateTime?
  status         EmployeeStatus  @default(ACTIVE)
  basicSalary    Float
  bankName       String?
  bankAccount    String?
  bankBranch     String?
  mpesaNumber    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendances    Attendance[]
  documents      Document[]
  department     Department      @relation(fields: [departmentId], references: [id])
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  paymentMethods PaymentMethod[]
  payrollEntries PayrollEntry[]
  salaryAdvances SalaryAdvance[]
  wallet         Wallet?

  @@map("employees")
}

model PaymentMethod {
  id            String      @id @default(cuid())
  employeeId    String
  type          PaymentType
  bankCode      String?
  accountNumber String?
  accountName   String?
  mpesaNumber   String?
  swiftCode     String?
  iban          String?
  primary       Boolean     @default(false)
  verified      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, primary], name: "one_primary_per_employee")
  @@map("payment_methods")
}

model PayrollRun {
  id          String         @id @default(cuid())
  month       Int
  year        Int
  status      PayrollStatus  @default(DRAFT)
  totalGross  Float          @default(0)
  totalTax    Float          @default(0)
  totalNet    Float          @default(0)
  approvedAt  DateTime?
  disbursedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  entries     PayrollEntry[]

  @@unique([month, year])
  @@map("payroll_runs")
}

model PayrollEntry {
  id           String     @id @default(cuid())
  payrollRunId String
  employeeId   String
  basicSalary  Float
  allowances   Float      @default(0)
  deductions   Float      @default(0)
  paye         Float      @default(0)
  nssf         Float      @default(0)
  shif         Float      @default(0)
  housingLevy  Float      @default(0)
  grossSalary  Float
  netSalary    Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employee     Employee   @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_entries")
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  clockIn    DateTime?
  clockOut   DateTime?
  status     AttendanceStatus @default(ABSENT)
  overtime   Float            @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  employee   Employee         @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@map("attendances")
}

model LeaveType {
  id          String         @id @default(cuid())
  name        String         @unique
  totalDays   Int
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  balances    LeaveBalance[]
  requests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id          String        @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  days        Int
  reason      String?
  status      RequestStatus @default(PENDING)
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  employee    Employee      @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType     @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  total       Int
  used        Int       @default(0)
  remaining   Int
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model SalaryAdvance {
  id         String        @id @default(cuid())
  employeeId String
  amount     Float
  reason     String
  status     RequestStatus @default(PENDING)
  schedule   String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  employee   Employee      @relation(fields: [employeeId], references: [id])

  @@map("salary_advances")
}

model ComplianceRecord {
  id        String           @id @default(cuid())
  type      ComplianceType
  month     Int
  year      Int
  amount    Float
  dueDate   DateTime         @db.Date
  filedDate DateTime?        @db.Date
  status    ComplianceStatus @default(PENDING)
  reference String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([type, month, year])
  @@map("compliance_records")
}

model Document {
  id         String       @id @default(cuid())
  name       String
  type       DocumentType
  url        String
  size       Int?
  employeeId String?
  uploadedAt DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  employee   Employee?    @relation(fields: [employeeId], references: [id])

  @@map("documents")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model CompanyProfile {
  id                 String   @id @default(cuid())
  name               String   @unique
  registrationNumber String
  kraPin             String   @unique
  nssfNumber         String   @unique
  nhifNumber         String   @unique
  shilNumber         String?
  address            String
  city               String
  country            String
  phone              String
  email              String
  logo               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("company_profiles")
}

model PayrollConfig {
  id                String   @id @default(cuid())
  paymentFrequency  String   @default("MONTHLY")
  paymentDate       Int      @default(25)
  taxYear           Int      @default(2026)
  nssfContribution  Float    @default(6.0)
  nhifContribution  Float    @default(1.75)
  shilfContribution Float    @default(0.5)
  housingLevyRate   Float    @default(1.5)
  defaultOvertime   Float    @default(1.5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payroll_configs")
}

model LeavePolicy {
  id               String   @id @default(cuid())
  annualLeaveDays  Int      @default(20)
  sickLeaveDays    Int      @default(10)
  maternityDays    Int      @default(90)
  paternityDays    Int      @default(7)
  carryoverDays    Int      @default(5)
  carryoverExpiry  Int      @default(12)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("leave_policies")
}

model AttendanceRule {
  id                 String   @id @default(cuid())
  workStartTime      String   @default("09:00")
  workEndTime        String   @default("17:00")
  lateThreshold      Int      @default(15)
  absentThreshold    Int      @default(30)
  overtimeMultiplier Float    @default(1.5)
  autoMarkAttendance Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("attendance_rules")
}

model RolePermission {
  id        String   @id @default(cuid())
  role      String
  resource  String
  action    String
  granted   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource, action])
  @@map("role_permissions")
}

model Integration {
  id           String    @id @default(cuid())
  name         String    @unique
  type         String
  isActive     Boolean   @default(false)
  credentials  String?
  apiKey       String?
  webhookUrl   String?
  lastSyncAt   DateTime?
  syncInterval Int       @default(3600)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("integrations")
}

model Wallet {
  id           String              @id @default(cuid())
  employeeId   String              @unique
  balance      Float               @default(0)
  currency     String              @default("KES")
  lastTopupAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id               String                @id @default(cuid())
  walletId         String
  type             WalletTransactionType
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  status           TransactionStatus     @default(PENDING)
  paymentReference String?
  pesapalReference String?
  description      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  wallet           Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

enum PaymentType {
  BANK
  MPESA
  INTERNATIONAL
}

enum WalletTransactionType {
  TOPUP
  WITHDRAWAL
  DISBURSEMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  FINANCE
  MANAGER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  DISBURSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplianceType {
  PAYE
  NSSF
  SHIF
  HOUSING_LEVY
}

enum ComplianceStatus {
  PENDING
  FILED
  OVERDUE
  DUE_SOON
}

enum DocumentType {
  CONTRACT
  PAYSLIP
  TAX
  COMPLIANCE
  POLICY
  OTHER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}
